# Copy to .env.production before `npm run build` for Hostinger (staging or live).
# The API address is built into the web files, so build once per target.
# Staging example:  https://api-staging.YOUR-DOMAIN.com/api
# Live example:     https://api.YOUR-DOMAIN.com/api
VITE_API_BASE_URL=https://api.YOUR-DOMAIN.com/api
